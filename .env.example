# Vercel AI Gateway key for local development. On Vercel, OIDC auth is automatic.
AI_GATEWAY_API_KEY=

# Optional. Model in provider/model form from https://ai-gateway.vercel.sh/v1/models
# SCAN_MODEL=anthropic/claude-sonnet-5.5

# Optional locally: without these, reports go to .msgdrift-data/ and limits are in memory.
# BLOB_READ_WRITE_TOKEN=
# BLOB_ACCESS=public
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Secret used to hash visitor IPs for rate limiting. Set a long random value in production.
RATE_LIMIT_SALT=

# Zero data retention on the AI Gateway provider path. On by default; set 0 only if the plan lacks it.
# SCAN_ZDR=1

# Optional overrides
# SCAN_LIMIT_IP_HOURLY=3
# SCAN_LIMIT_IP_DAILY=10
# SCAN_LIMIT_GLOBAL_DAILY=200
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
